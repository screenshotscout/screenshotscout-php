<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnWarning="true">
  <testsuites>
    <testsuite name="Screenshot Scout SDK">
      <directory>tests</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory>src</directory>
    </include>
  </source>
  <php>
    <!-- Every client reads this variable, even with keys passed, so a developer's own value must not reach
         the tests. An empty value counts as unset. -->
    <env name="SCREENSHOTSCOUT_BASE_URL" value="" force="true"/>
  </php>
</phpunit>
