{
  "name": "screenshotscout/sdk",
  "description": "Official PHP SDK for the Screenshot Scout screenshot API.",
  "type": "library",
  "keywords": [
    "screenshot",
    "screenshot-api",
    "screenshotscout",
    "sdk",
    "url-to-image",
    "webpage-screenshot",
    "website-screenshot"
  ],
  "homepage": "https://screenshotscout.com",
  "license": "MIT",
  "authors": [
    {
      "name": "Oleksii Velykyi"
    }
  ],
  "support": {
    "issues": "https://github.com/screenshotscout/screenshotscout-php/issues",
    "source": "https://github.com/screenshotscout/screenshotscout-php"
  },
  "require": {
    "php": ">=8.3",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "ScreenshotScout\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ScreenshotScout\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
    "check": [
      "@format:check",
      "@analyse",
      "@test"
    ],
    "format": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
    "format:check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
    "test": "phpunit --configuration=phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true
  }
}
